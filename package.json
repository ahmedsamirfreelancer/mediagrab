{
  "name": "mediagrab",
  "version": "1.0.38",
  "description": "MediaGrab — Multi-platform video downloader",
  "main": "main.js",
  "author": "Ahmed",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/download-binaries.js && electron-builder install-app-deps || true",
    "binaries": "node scripts/download-binaries.js",
    "start": "electron .",
    "obfuscate": "node scripts/obfuscate.js",
    "restore": "node scripts/restore.js",
    "build": "node scripts/obfuscate.js && electron-builder --win nsis && node scripts/restore.js",
    "build:noobf": "electron-builder --win nsis",
    "build:mac": "node scripts/obfuscate.js && electron-builder --mac && node scripts/restore.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.2.2"
  },
  "build": {
    "appId": "com.arqami.mediagrab",
    "productName": "MediaGrab",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload-main.js",
      "preload-tiktok-embed.js",
      "preload-instagram-embed.js",
      "preload-facebook-embed.js",
      "preload-fb-adlibrary.js",
      "preload-pinterest-embed.js",
      "server/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/afterPack-adhoc-sign.js",
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ahmedsamirfreelancer",
        "repo": "mediagrab-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MediaGrab-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "MediaGrab-${version}-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "dmg": {
      "title": "MediaGrab ${version} ${arch}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MediaGrab",
      "installerLanguages": [
        "en_US",
        "ar_SA"
      ],
      "language": "1033"
    }
  }
}
