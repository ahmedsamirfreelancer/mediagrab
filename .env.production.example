# Copy to .env.production and set the secret.
# MUST match LICENSE_TOKEN_SECRET on arqami.app.
# Rotate periodically; rotating invalidates all existing license tokens
# (clients will re-validate against the server on next startup).
MEDIAGRAB_BUILD_SECRET=replace-with-your-strong-secret-matching-arqami-app

# OPTIONAL — owner-only auto-activation key.
# If set, the desktop app silently activates with this key on first launch
# (no activation screen). Leave EMPTY for customer/distribution builds.
# Generate a key from arqami.app /licenses → MediaGrab.
MEDIAGRAB_OWNER_KEY=
